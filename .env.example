# Copy this file to .env and fill in real values. .env is gitignored.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aldrop
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Platform admin (Basic Auth for /platform/** endpoints) ---
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=changeme

# --- Environment ---
# QA exposes the OpenAPI docs at /swagger-ui/index.html and /v3/api-docs.
# PROD, or leaving this unset, hides them (they answer 404).
ENV=QA

# --- Meridian (IP geolocation, used to enrich auth_events with city/country) ---
MERIDIAN_BASE_URL=http://localhost:9090
